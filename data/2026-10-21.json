      "title": "CanvasObs introduces spatial observation for agent editing on infinite canvases",
      "summary": "Researchers developed CanvasObs, a spatial observation layer for infinite canvas environments that allows editing agents to inspect hidden application states, offscreen objects, and connector bindings rather than relying purely on pixels.",
      "design_implication": "A designer prompts an agent to restyle an entire user flow across multiple boards, but visual grouping tricks pixel-based models into modifying the wrong frames. Exposing structured scene graphs lets tools execute spatial updates without corrupting layered hierarchies.",
      "implication_lens": "capability",
      "visual_need": "illustrate",
      "source_name": "arXiv cs.HC",
      "source_url": "https://arxiv.org/abs/2610.27176",
      "source_date": "2026-10-21",
      "evidence": [
        {
          "claim": "Agents editing 2D canvases fail when spatial pixels diverge from underlying object bindings.",
          "quote": "visual containment and touching arrows may disagree with recorded frame membership or connector bindings."
        }
      ],
